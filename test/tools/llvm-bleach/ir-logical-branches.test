# RUN: %bin/llvm-bleach %S/inputs/logical-branches.mir \
# RUN:   --instructions=%S/inputs/logical.yaml -noinline-instr \
# RUN:   --lifted-prefix=bleached_ | FileCheck %s

# CHECK: define void @bleached_foo(ptr %0) {
# CHECK-NEXT:   %GPR = getelementptr i8, ptr %0, i64 0
# CHECK:   br label %[[BLOCK1:[0-9]+]]
# CHECK: [[BLOCK1]]:
# CHECK:   ret void
# CHECK-NEXT: }
