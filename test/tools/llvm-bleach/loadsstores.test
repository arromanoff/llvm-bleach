# RUN: %bin/llvm-bleach %S/inputs/loadsstores.mir \
# RUN:   --instructions=%S/inputs/logical.yaml --noinline-instr \
# RUN:   --stack-size 8000 --lifted-prefix=bleached_ | FileCheck %s

# CHECK: define void @bleached_SnippyFunction(ptr %0) {
# CHECK: %[[SP:[0-9]+]] = call i64 @ADDI(i64 %{{[0-9]+}}, i64 6)
# CHECK: %[[IDX:[0-9]+]] = add i64 %[[SP]], -5
# CHECK: %[[STACK:[0-9]+]] = getelementptr i8, ptr %0, i64 256
# CHECK: %[[ADDR:[0-9]+]] = getelementptr inbounds [8 x i8], ptr %[[STACK]], i64 %[[IDX]]
# CHECK: %[[LOADED:[0-9]+]] = load i64, ptr %[[ADDR]]

# CHECK: %[[IDX2:[0-9]+]] = add i64 %[[SP]], -3
# CHECK: %[[STACK2:[0-9]+]] = getelementptr i8, ptr %0, i64 256
# CHECK: %[[ADDR2:[0-9]+]] = getelementptr inbounds [8 x i8], ptr %[[STACK2]], i64 %[[IDX2]]
# CHECK: store i64 %[[LOADED]], ptr %[[ADDR2]]
