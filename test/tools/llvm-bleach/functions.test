# RUN: %bin/llvm-bleach %S/inputs/functions.mir \
# RUN:   --instructions=%S/inputs/logical.yaml --lifted-prefix=bleach_ \
# RUN:   | FileCheck %s

# SnippyFunction has 4 calls to fun2. Check that all calls are
# embraced with storing registers to state and loading afterwards

# CHECK: define void @bleach_SnippyFunction(ptr %0) {

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64


# CHECK: define void @bleach_fun1(ptr %0)

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun2(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# 4 calls from fun2 to fun3
# CHECK: define void @bleach_fun2(ptr %0)

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun3(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun3(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun3(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

# CHECK-COUNT-32:   store i64
# CHECK:   call void @bleach_fun3(ptr %0)
# CHECK-COUNT-32:   {{%[0-9]+}} = load i64

