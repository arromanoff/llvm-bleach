@LIT_SITE_CFG_IN_HEADER@

import sys
import os
import lit.llvm

config.src_root = r'${CMAKE_SOURCE_DIR}'
config.obj_root = r'${CMAKE_BINARY_DIR}'
config.substitutions.append(("%llvm/", r"${LLVM_TOOLS_BINARY_DIR}/"))
if "${MCTOMIR_ENABLE_TMS320}" == "ON" and "TMS320" in "${LLVM_TARGETS_TO_BUILD}".split(";"):
    config.available_features.add("tms320")

lit.llvm.initialize(lit_config, config)
lit_config.load_config(config, os.path.join(config.src_root, "test/tools/mctomir/lit.cfg.py"))
config.suffixes = [ ".c", ".test" ]
